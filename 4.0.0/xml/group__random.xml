<parameterdescription>
<para>Output buffer for the generated data. </para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes to generate and output.</para></parameterdescription>
</parameteritem>
</parameterlist>
