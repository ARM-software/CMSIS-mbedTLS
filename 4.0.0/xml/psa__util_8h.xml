      <memberdef kind="define" id="group__psa__tls__helpers_1gad0e232a5d5b29f0fccee1522debba85c" prot="public" static="no">
        <name>MBEDTLS_ECDSA_DER_MAX_SIG_LEN</name>
        <param><defname>bits</defname></param>
        <initializer>(/*T,L of SEQUENCE*/ ((bits) &gt;= 61 * 8 ? 3 : 2) +              \
     /*T,L of r,s*/ 2 * (((bits) &gt;= 127 * 8 ? 3 : 2) +     \
                         /*V of r,s*/ ((bits) + 8) / 8))</initializer>
        <briefdescription>
<para>Maximum size of a DER-encoded ECDSA signature for a given curve bit size. </para>        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>bits</parametername>
</parameternamelist>
<parameterdescription>
<para>Curve size in bits. </para></parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Maximum signature size in bytes.</para></simplesect>
<simplesect kind="note"><para>This macro returns a compile-time constant if its argument is one. It may evaluate its argument multiple times. </para></simplesect>
</para>        </detaileddescription>
