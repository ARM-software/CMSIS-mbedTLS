        <initializer><ref refid="group__psa__tls__helpers_1gad0e232a5d5b29f0fccee1522debba85c" kindref="member">MBEDTLS_ECDSA_DER_MAX_SIG_LEN</ref>(<ref refid="crypto__sizes_8h_1a81080a6cbbab87f35b114cb991e3f550" kindref="member">PSA_VENDOR_ECC_MAX_CURVE_BITS</ref>)</initializer>
        <briefdescription>
        </briefdescription>
