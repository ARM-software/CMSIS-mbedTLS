        <type>int</type>
        <definition>int mbedtls_ecdsa_der_to_raw</definition>
        <argsstring>(size_t bits, const unsigned char *der, size_t der_len, unsigned char *raw, size_t raw_size, size_t *raw_len)</argsstring>
        <name>mbedtls_ecdsa_der_to_raw</name>
        <param>
          <type>size_t</type>
          <declname>bits</declname>
        </param>
        <param>
          <type>const unsigned char *</type>
          <declname>der</declname>
        </param>
        <param>
          <type>size_t</type>
